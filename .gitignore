# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Environment
.env
*.env.local

# ML Models & Data
# Globally ignore large/temporary model artifacts...
models/*.joblib
models/champion/*.joblib
models/candidates/
*.db
insureai.db
data/insureai.db
data/processed/
backups/
scratch*

# ...BUT explicitly track champion release models in git so clean-clone is reproducible.
# Without this exception, a fresh clone cannot run without retraining (not reproducible).
# The *.joblib global rule above is overridden for release directories only.
!models/releases/**
!models/releases/**/*.joblib


# Jupyter
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Reports
reports/*.html
reports/*.json
reports/*.pdf
reports/batch_*.csv

# Runtime logs (generated at server start)
logs/
