# InsureAI Environment Configuration
# Copy this file to .env and adjust values

# Application
APP_NAME=InsureAI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS – comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///insureai.db

# Security — Registry API Key
# Protects /registry/approve, /registry/promote, /registry/rollback endpoints.
# CHANGE THIS to a strong random secret before any deployment.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=insureai-dev-key-change-in-production

# ML Configuration
RANDOM_SEED=42
MODEL_SELECTION_METRIC=f1
CLAIM_RATE=0.30
NOISE_LEVEL=0.15
NUMBER_OF_ROWS=5000
DEFAULT_THRESHOLD=0.5

# Risk Score Thresholds (0-100)
LOW_RISK_MAX=25
MODERATE_RISK_MAX=50
HIGH_RISK_MAX=75

# Cost Analysis Defaults (INR)
FP_COST=500
FN_COST=5000

# File Upload
MAX_UPLOAD_SIZE_MB=10

# Currency Symbol
CURRENCY_SYMBOL=₹
